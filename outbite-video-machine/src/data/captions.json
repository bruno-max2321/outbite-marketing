      "endSeconds": 3.2,
      "text": "Same restaurant. Same Big Mac.",
      "emphasis": ["Big Mac"]
    },
    {
      "id": "cap-02",
      "speaker": "right",
      "startSeconds": 3.2,
      "endSeconds": 6.27,
      "text": "The side you pick changes everything.",
      "emphasis": ["side", "everything"]
    },
    {
      "id": "cap-03",
      "speaker": "left",
      "startSeconds": 6.27,
      "endSeconds": 10.04,
      "text": "But the fries look so good… how do I even compare?",
      "emphasis": ["fries", "compare"]
    },
    {
      "id": "cap-04",
      "speaker": "right",
      "startSeconds": 10.04,
      "endSeconds": 13.0,
      "text": "Fries can add hundreds of extra calories.",
      "emphasis": ["hundreds", "calories"]
    },
    {
      "id": "cap-05",
      "speaker": "right",
      "startSeconds": 13.0,
      "endSeconds": 16.06,
      "text": "I scan the menu with Outbite first.",
